# Vantalens Writer Environment Configuration
# Copy this file to .env and fill in your actual values

# Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here
JWT_TTL_HOURS=24
JWT_SECRET=your_jwt_secret_key_here_use_random_64_char_hex

# Network
HTTP_PORT=8080
HTTPS_PORT=443
BEHIND_PROXY=false
ALLOWED_ORIGINS=https://vantalens.github.io

# SMTP
SMTP_PASSWORD=your_smtp_password_here
SMTP_ENCRYPTION_KEY=your_32_char_hex_encryption_key

# Site
BASE_URL=https://example.com
SITE_TITLE=My Blog
