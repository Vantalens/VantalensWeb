# Vantalens Writer Environment Configuration
# Copy this file to .env and fill in your actual values

# Authentication
ADMIN_USERNAME=vantalens
ADMIN_PASSWORD=your_secure_password_here
JWT_TTL_HOURS=24
JWT_SECRET=your_jwt_secret_key_here_use_random_64_char_hex

# Network
HTTP_PORT=8080
HTTPS_PORT=443
BEHIND_PROXY=false
ALLOWED_ORIGINS=https://vantalens.github.io

# SMTP
SMTP_PASSWORD=your_smtp_password_here
SMTP_ENCRYPTION_KEY=your_32_char_hex_encryption_key

# Site
BASE_URL=https://example.com
SITE_TITLE=My Blog
HUGO_PATH=/path/to/writable/site-worktree
PUBLISH_OUTPUT_PATH=/path/to/writable/publish-output

# Runtime database sync
# Local cache fallback only. Normal admin reads/writes should use REMOTE_ADMIN_BASE.
DB_SYNC_ENABLED=false
DB_SYNC_REMOTE_HOST=wj
DB_SYNC_REMOTE_BASE=/var/lib/vantalens
DB_SYNC_SCP_BIN=scp
DB_SYNC_INTERVAL=5m
DB_SYNC_TIMEOUT=30s

# Remote authority backend
# On the production server set AUTHORITY_BACKEND=true and leave REMOTE_ADMIN_BASE empty.
# On a local Windows web.exe set REMOTE_ADMIN_BASE to the production backend.
AUTHORITY_BACKEND=false
REMOTE_ADMIN_BASE=https://vantalens.com
REMOTE_ADMIN_TOKEN=your_admin_token_or_password_here
LOCAL_CACHE_ENABLED=true
